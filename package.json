{
  "name": "whereiwalk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --import tsx --test test/*.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "trails:fetch": "tsx --env-file-if-exists=.env scripts/fetch-trails.ts",
    "trails:load": "tsx --env-file-if-exists=.env scripts/load-trails.ts",
    "postinstall": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@tmcw/togeojson": "7.1.3",
    "fit-file-parser": "6.2.2",
    "jszip": "3.10.2",
    "maplibre-gl": "6.15.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xmldom/xmldom": "0.9.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
