# Postgres connection string. On Vercel this is set by the Neon integration.
# Local example: postgres://postgres:postgres@localhost:5432/whereiwalk
DATABASE_URL=

# --- Sign-in (Auth.js + Google) ---
# Random secret for signing sessions: `openssl rand -base64 32`
AUTH_SECRET=
# From Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Admins (comma separated): can always sign in and manage invites in the app.
# Everyone else is invited on the Invites page. The first email is the owner.
ALLOWED_EMAILS=

# Local development only (ignored on Vercel): show a "test login" that signs in as
# any ALLOWED_EMAILS address without Google. Needs AUTH_TRUST_HOST=1 with `npm start`.
# AUTH_DEV_LOGIN=1
# AUTH_TRUST_HOST=1
